<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ist Intranet</title>
    <link rel="shortcut icon" href="~/Assent/Favicon/logo.ico" type="image/x-icon" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @*<link rel="stylesheet" href="~/PaginaIst.styles.css" asp-append-version="true" /> *@

    <!--Css todos-->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.0/css/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.0.0/css/buttons.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/themes/base/jquery-ui.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.10.5/sweetalert2.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center"
                   asp-area="Usuario" asp-controller="Home" asp-action="Index">
                    <img src="~/Assent/Ist/logo.jpg" alt="Logo IST" width="48" height="30" class="me-2">
                    Intranet Ist
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01"
                        aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarColor01">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link active" asp-area="Usuario" asp-controller="Home" asp-action="Index">
                                Inicio
                                <span class="visually-hidden">(current)</span>
                            </a>
                        </li>

                        @if ( User.IsInRole ( "Admin" ) || User.IsInRole ( "IT" ) )
                            {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button"
                                   aria-haspopup="true" aria-expanded="false">IT</a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Mantenimientos" asp-action="Index">Mantenimientos</a>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Contrasena" asp-action="Index">Paginas_TI</a>
                                </div>
                            </li>
                            }

                        @if ( User.IsInRole ( "Admin" ) || User.IsInRole ( "IT" ) || User.IsInRole ( "Mantenimiento" ) )
                            {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button"
                                   aria-haspopup="true" aria-expanded="false">Equipos</a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-area="EquiposIst" asp-controller="EquipoIT" asp-action="Index">Equipos Ist</a>
                                    <a class="dropdown-item" asp-area="EquiposRentados" asp-controller="EquipoRentados" asp-action="Index">Equipos Rentados</a>
                                </div>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button"
                                   aria-haspopup="true" aria-expanded="false">Mantenimientos</a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Mantenimientos" asp-action="Index">Mantenimientos Ist</a>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Rentados" asp-action="Index">Mantenimientos Rentados</a>
                                </div>
                            </li>
                            }

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button"
                               aria-haspopup="true" aria-expanded="false">HSEQ</a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item" asp-area="Usuario" asp-controller="Recursos" asp-action="Index">HSEQ</a>
                            </div>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button"
                               aria-haspopup="true" aria-expanded="false">Tickets</a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item" asp-area="Admin" asp-controller="It" asp-action="Index">Ticket TI</a>
                                <a class="dropdown-item" asp-area="Ticket" asp-controller="Home" asp-action="Index">Ticket Mantenimiento</a>
                            </div>
                        </li>
                    </ul>
                </div>

                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody( )
        </main>
    </div>

    <footer class="bg-primary text-light py-4">
        <div class="container">
            <div class="row">
                <!-- Sección de enlaces rápidos -->
                <div class="col-md-4">
                    <h5 class="text-uppercase">Enlaces Rápidos</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-light text-decoration-none">Inicio</a></li>
                        <li><a href="#" class="text-light text-decoration-none">Mantenimiento</a></li>
                        <li><a href="#" class="text-light text-decoration-none">HSEQ</a></li>
                        @*                         <li><a href="#" class="text-light text-decoration-none">Contacto</a></li>
 *@                    </ul>
                </div>

                <!-- Sección de contacto -->
                <div class="col-md-4">
                    <h5 class="text-uppercase">Contacto</h5>
                    <p>
                        <strong>Intranet IST</strong><br>
                        Dirección: Calle 93 #12-14, Bogotá, Colombia<br>
                        Teléfono: (601) 3288830<br>
                        Email: <a href="mailto:ist@ist-internacional.com.co" class="text-light text-decoration-none">ist@ist-internacional.com.co</a>
                    </p>
                </div>

                <!-- Sección de redes sociales -->
                <div class="col-md-4">
                    <h5 class="text-uppercase">Síguenos</h5>
                    <ul class="list-unstyled d-flex gap-3">
                        <li><a href="https://www.youtube.com/watch?v=excf_eNw-BA" class="text-light text-decoration-none"><i class="fab fa-youtube"></i> Youtube</a></li>
                        <li><a href="#" class="text-light text-decoration-none"><i class="fab fa-twitter"></i> X</a></li>
                        <li><a href="#" class="text-light text-decoration-none"><i class="fab fa-linkedin"></i> LinkedIn</a></li>
                    </ul>
                </div>
            </div>
            <hr class="border-light">
            <div class="text-center">
                <p>&copy; 2024 - PaginaIst. Todos los derechos reservados. <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-light text-decoration-none">Política de Privacidad</a></p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!--Js plugins-->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/jquery-ui.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.0/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.0/js/dataTables.buttons.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery.serializeJSON/3.2.1/jquery.serializejson.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.10.5/sweetalert2.min.js"></script>
    <!-- Requerido para excelHtml5 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.0/js/buttons.html5.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery.serializeJSON/3.2.1/jquery.serializejson.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.10.5/sweetalert2.min.js"></script>


    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync( "Scripts" , @required: false )
    </body>
</html>
