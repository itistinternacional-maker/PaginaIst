@{
    ViewData ["Title"] = "Lista de Mantenimientos";
    }

<div class="container mt-4">
    <div class="row">
        <div class="col-8">
            <h2 class="text-primary">Lista de Mantenimientos</h2>
        </div>
        <div class="col-4 text-right">
            @if ( User.IsInRole ( "Admin" ) || User.IsInRole ( "IT" ) || User.IsInRole ( "Mantenimiento" ) )
                {
                <a asp-action="Create" class="btn btn-primary w-100">
                    <i class="fa-solid fa-plus"></i> Crear Nuevo mantenimiento
                </a>
                }
            <button type="button" class="btn btn-success w-100" onclick="exportarExcelDT(event)">
                <i class="fa-solid fa-file-excel"></i> EXPORTAR A EXCEL
            </button>

            <!-- Aquí vamos a mover el botón de Excel -->
            <div id="excelExportContainer" class="mt-2"></div>
        </div>
    </div>

    <br /><br />

    <table id="tblMantenimiento" class="table table-striped table-bordered" style="width: 100%">
        <thead>
            <tr>
                <th>Id</th>
                <th>FECHA</th>
                <th>PLACA</th>
                <th>TIPO MANTTO</th>
                <th>COMENTARIO</th>
                <th>RUTA ASIGNADA</th>
                <th>ACCION</th>
            </tr>
        </thead>
    </table>
</div>

    @section Scripts {
    <script>
        window.canEditMantenimiento = @( (User.IsInRole("Admin") || User.IsInRole("IT") || User.IsInRole("Mantenimiento")).ToString().ToLower() );
    </script>
    <script src="~/js/mantenimiento.js"></script>
    }
